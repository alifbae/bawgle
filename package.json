{
  "name": "bawgle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "scripts": {
    "dev": "BAWGLE_ENVIRONMENT=development concurrently -n client,server,admin -c cyan,magenta,yellow \"vite --port 5175\" \"tsx watch --env-file-if-exists=./.env src/server/index.ts\" \"tsx src/admin-panel/build.ts --watch\"",
    "build": "pnpm run build:admin && vite build",
    "build:admin": "tsx src/admin-panel/build.ts",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "docs:lint": "markdownlint-cli2 \"docs/src/**/*.md\"",
    "docs:build": "pnpm run docs:lint && mkdocs build --strict",
    "denylist:apply": "tsx scripts/apply-denylist.ts",
    "dict:reconcile": "tsx scripts/apply-denylist.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "compose:dev": "docker compose -f docker-compose.dev.yml up -d --build",
    "compose:dev:down": "docker compose -f docker-compose.dev.yml down",
    "compose:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "compose:prod": "docker compose pull && docker compose up -d",
    "compose:prod:down": "docker compose down",
    "compose:prod:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "better-sqlite3": "^11.3.0",
    "hono": "^4.6.0",
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^2.1.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^15.11.0",
    "jsdom": "^25",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.3.3",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "svelte-eslint-parser": "^1.6.1",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.12.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
