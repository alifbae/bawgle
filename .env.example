# bawgle admin dashboard at /admin. If BAWGLE_ADMIN_PASS is unset the
# admin surface is disabled entirely (no default credential). User
# defaults to `admin` but can be overridden.
BAWGLE_ADMIN_USER=admin
BAWGLE_ADMIN_PASS=

# Event log retention in days. Events persist as JSONL under /data/logs.
BAWGLE_LOG_RETENTION_DAYS=30

# Build/runtime environment flag. Set to `development` to enable client-side
# dev helpers (window.bawgleDev) for fast UI iteration. Anything else (or
# unset) is treated as production and strips the helpers from the bundle.
BAWGLE_ENVIRONMENT=

# Comma-separated list of allowed Origin values for WebSocket upgrades.
# When unset, any origin is accepted (fine for local dev, risky in prod).
# Set to your public URL(s) for a real deployment, e.g.:
#   BAWGLE_ALLOWED_ORIGINS=https://bawgle.example.com
BAWGLE_ALLOWED_ORIGINS=

# Set to `1` when the server sits behind a trusted reverse proxy
# (nginx, Cloudflare Tunnel, Traefik, Caddy) so X-Forwarded-For /
# X-Real-IP headers are used to identify clients. Leave unset if the
# container is exposed directly to the internet — an attacker can
# trivially spoof these headers otherwise.
BAWGLE_TRUST_PROXY=
