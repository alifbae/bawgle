# bawgle admin dashboard at /admin. If BAWGLE_ADMIN_PASS is unset the
# admin surface is disabled entirely (no default credential). User
# defaults to `admin` but can be overridden.
BAWGLE_ADMIN_USER=admin
BAWGLE_ADMIN_PASS=

# Event log retention in days. Events persist as JSONL under /data/logs.
BAWGLE_LOG_RETENTION_DAYS=30

# Build/runtime environment flag. Set to `development` to enable client-side
# dev helpers (window.bawgleDev) for fast UI iteration. Anything else (or
# unset) is treated as production and strips the helpers from the bundle.
BAWGLE_ENVIRONMENT=
